#!/usr/bin/perl
#
# Noxity imapsync destination guard  —  CGI wrapper
# =================================================
# Installed at  /usr/lib/cgi-bin/imapsync  (public, NO auth).
#
# The browser's noxity-ips.js check is client-side only and trivially
# bypassed with curl. This wrapper re-does that check on the server, where
# it can't be skipped: it pulls the destination (host2) out of the POST,
# resolves it, and only hands the request to the real imapsync if it lands
# on an allow-listed Noxity IP. Everything else is refused.
#
# A migration takes minutes to hours, but Cloudflare gives up on any request
# that hasn't finished in 100 seconds (error 524). So a run is NOT streamed
# back on this request: it is started detached and answered immediately with
# a job id, and the browser tails the log through imapsync-log. Every request
# is short, so the proxy cap never applies. See the README, "Long migrations
# (status polling)".
#
# The real imapsync lives at $IMAPSYNC_REAL and is also exposed directly,
# behind HTTP basic auth, at /cgi-bin/imapsync-staff for support (/bypass/).
#
# No CPAN deps — core Perl (Socket, POSIX) only, already present for imapsync.
# See the README, "Locking the backend (server-side enforcement)".

use strict;
use warnings;
use Socket qw(inet_ntoa);
use POSIX qw(setsid);

# ---- config ---------------------------------------------------------------
my $IMAPSYNC_REAL = '/usr/lib/cgi-bin/imapsync-staff';  # the real program
my $ALLOWLIST     = '/var/www/html/noxity-ips.js';      # single source of truth
my $JOBS_DIR      = '/var/tmp/imapsync-jobs';           # one dir per run
my $JOB_TTL_DAYS  = 2;                                  # sweep logs older than
# ---------------------------------------------------------------------------

binmode STDIN;
binmode STDOUT;
$| = 1;

# Slurp the POST body (exactly CONTENT_LENGTH bytes), then pull out host2.
my $body = read_body($ENV{CONTENT_LENGTH} || 0);
my $dest = form_field($body, 'host2');

refuse($dest), exit 0 unless is_allowed($dest);

# Abort is a different animal: imapsync just signals the running PID and
# exits, so it finishes in well under a second. Run it inline and hand its
# output straight back — no job, nothing to poll.
if (form_field($body, 'abort') ne '') {
    run_inline($body);
    exit 0;
}

my $job = start_job($body);
print "Status: 202 Accepted\r\n",
      "Content-Type: text/plain; charset=utf-8\r\n",
      "Cache-Control: no-store\r\n",
      "X-Imapsync-Job: $job\r\n\r\n",
      "$job\n";
exit 0;

# ---- helpers --------------------------------------------------------------

sub read_body {
    my ($want) = @_;
    my $buf = '';
    return $buf if $want <= 0;
    my $got = 0;
    while ($got < $want) {
        my $n = read(STDIN, my $chunk, $want - $got);
        last if !defined $n || $n == 0;
        $buf .= $chunk;
        $got += $n;
    }
    return $buf;
}

# application/x-www-form-urlencoded -> the named field, decoded.
sub form_field {
    my ($buf, $name) = @_;
    for my $pair (split /&/, $buf) {
        my ($k, $v) = split /=/, $pair, 2;
        next unless defined $k && $k eq $name;
        $v = defined $v ? $v : '';
        $v =~ tr/+/ /;
        $v =~ s/%([0-9A-Fa-f]{2})/chr hex $1/ge;
        return $v;
    }
    return '';
}

# IPs pulled straight out of noxity-ips.js so browser and server never
# disagree. Missing file or empty list => no IPs => nothing is allowed.
sub allowed_ips {
    open my $fh, '<', $ALLOWLIST or return ();
    local $/;
    my $txt = <$fh>;
    close $fh;
    return $txt =~ /"(\d{1,3}(?:\.\d{1,3}){3})"/g;
}

sub is_allowed {
    my ($host) = @_;
    $host =~ s/^\s+|\s+$//g;
    return 0 if $host eq '';

    my %ok = map { $_ => 1 } allowed_ips();
    return 0 unless %ok;                          # fail closed: deny if no list

    if ($host =~ /^\d{1,3}(?:\.\d{1,3}){3}$/) {   # destination is a literal IP
        return $ok{$host} ? 1 : 0;
    }
    for my $ip (resolve_a($host)) {               # otherwise resolve A records
        return 1 if $ok{$ip};
    }
    return 0;
}

sub resolve_a {
    my ($host) = @_;
    my @h = gethostbyname($host) or return ();    # IPv4-only, matches the UI
    return map { inet_ntoa($_) } @h[4 .. $#h];
}

# 32 hex chars from urandom. Unguessable: the job id is the only thing
# authorising a reader of imapsync-log to see this migration's log.
sub new_job_id {
    open my $fh, '<', '/dev/urandom' or fail("urandom: $!");
    binmode $fh;
    read $fh, my $bytes, 16;
    close $fh;
    fail("urandom short read") unless defined $bytes && length($bytes) == 16;
    return unpack 'H*', $bytes;
}

# Start imapsync detached and return its job id. The browser gets an answer
# now; the sync outlives this request, this CGI, and the browser tab.
sub start_job {
    my ($body) = @_;
    fail("real imapsync not executable at $IMAPSYNC_REAL") unless -x $IMAPSYNC_REAL;

    mkdir $JOBS_DIR, 0700 unless -d $JOBS_DIR;
    fail("jobs dir unusable at $JOBS_DIR") unless -d $JOBS_DIR && -w $JOBS_DIR;
    sweep_old_jobs();

    my $job = new_job_id();
    my $dir = "$JOBS_DIR/$job";
    mkdir $dir, 0700 or fail("mkdir $dir: $!");

    defined(my $pid = fork) or fail("fork: $!");
    return $job if $pid;                # parent: answer the browser and go

    # ---- supervisor ------------------------------------------------------
    # Detach from Apache completely. Holding any of its descriptors would
    # keep the HTTP request open — which is the exact thing we are avoiding.
    setsid();
    open STDIN,  '<', '/dev/null';
    open STDOUT, '>', '/dev/null';
    open STDERR, '>', '/dev/null';

    # Body goes down a pipe, never to disk: it carries both passwords.
    # It is a few hundred bytes, far under the pipe buffer, so this cannot
    # block before the worker starts reading.
    pipe(my $rd, my $wr) or exit 1;
    defined(my $kid = fork) or exit 1;

    unless ($kid) {                     # worker: imapsync, output -> log file
        close $wr;
        open STDIN,  '<&', $rd            or exit 1;
        open STDOUT, '>',  "$dir/log"     or exit 1;
        open STDERR, '>&', \*STDOUT       or exit 1;
        exec { $IMAPSYNC_REAL } $IMAPSYNC_REAL;
        exit 1;
    }

    close $rd;
    print {$wr} $body;
    close $wr;
    waitpid $kid, 0;

    # The exit file is the done flag. Written last, so imapsync-log can never
    # report "finished" while the log still has bytes coming.
    if (open my $fh, '>', "$dir/exit") {
        print {$fh} ($? >> 8), "\n";
        close $fh;
    }
    exit 0;
}

# Logs are kept only long enough for support to read them back.
sub sweep_old_jobs {
    opendir my $dh, $JOBS_DIR or return;
    my $cutoff = time - $JOB_TTL_DAYS * 86400;
    for my $entry (readdir $dh) {
        next unless $entry =~ /^[0-9a-f]{32}$/;   # only ever our own dirs
        my $dir = "$JOBS_DIR/$entry";
        next unless -d $dir;
        next unless (stat $dir)[9] < $cutoff;
        unlink "$dir/log", "$dir/exit";
        rmdir $dir;
    }
    closedir $dh;
}

# Allowed and short-lived (abort): run the real imapsync, feeding it the same
# body on stdin and letting its output flow straight back to Apache.
sub run_inline {
    my ($body) = @_;
    fail("real imapsync not executable at $IMAPSYNC_REAL") unless -x $IMAPSYNC_REAL;

    pipe(my $rd, my $wr) or fail("pipe: $!");
    defined(my $pid = fork) or fail("fork: $!");

    unless ($pid) {                  # child: stdin <- pipe; stdout -> Apache
        close $wr;
        open STDIN, '<&', $rd or exit 1;
        exec { $IMAPSYNC_REAL } $IMAPSYNC_REAL or exit 1;
    }

    close $rd;                       # parent: push the saved body in, then wait
    print {$wr} $body;
    close $wr;
    waitpid $pid, 0;
}

sub refuse {
    my ($host) = @_;
    $host = $host ne '' ? $host : '(none)';
    print "Status: 403 Forbidden\r\n",
          "Content-Type: text/plain; charset=utf-8\r\n\r\n",
          "Refused: \"$host\" is not a Noxity destination.\n",
          "Migrations are only accepted into Noxity-hosted mailboxes.\n";
}

sub fail {
    my ($msg) = @_;
    print "Status: 500 Internal Server Error\r\n",
          "Content-Type: text/plain\r\n\r\n",
          "imapsync guard error: $msg\n";
    exit 1;
}
